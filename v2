#include <pcap.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Idernet {
    unsigned char dst_mac[6];
    unsigned char src_mac[6];
    unsigned char type[2];
} Idernet;

typedef struct Ip{
    int ihl;
    unsigned char useless[11];
    unsigned char src_ip[4];
    unsigned char dst_ip[4];
}Ip;

typedef struct Tcp {
    unsigned char src_tcp[2];
    unsigned char dst_tcp[2];
    unsigned char useless[8];
    unsigned char ihl[1];
    unsigned char useless_2[7];
}Tcp;

typedef struct Other{
    unsigned char a[1000];
}Other;

void usage() {
    printf("syntax: pcap-test <interface>\n");
    printf("sample: pcap-test wlan0\n");
}

typedef struct {
    char* dev_;
} Param;

Param param = {
    .dev_ = NULL
};

bool parse(Param* param, int argc, char* argv[]) {
    if (argc != 2) {
        usage();
        return false;
    }

    param->dev_ = argv[1];
    return true;
}

void last_printf (const struct pcap_pkthdr* header,const u_char* packet){

    unsigned char eth[10000];

    memcpy(eth,packet,header->caplen);  
    //idernet, ip, tcp 받을공간 선언문 
    Idernet idernet;
    Ip ip;
    Tcp tcp;
    Other other;

    //idernet 에 값 넣는 명령어 
    memcpy(idernet.dst_mac, eth, 6);
    memcpy(idernet.src_mac, eth + 6, 6);
    memcpy(idernet.type, eth + 12, 2);

    //ip.ihl 에 직접 ihl 길이 넣어주는 명령어 (임시)
    ip.ihl = eth[14] & 0x0F;

    //ip 값들 넣어주는 명령어 이때 첫번째 바이트는 제외함. 
    memcpy(ip.useless, eth + 15, 11);
    memcpy(ip.src_ip, eth + 26, 4);
    memcpy(ip.dst_ip, eth + 30, 4);
        
    memcpy(tcp.src_tcp, eth + 14+ip.ihl*4, 2);
    memcpy(tcp.dst_tcp, eth + 16+ip.ihl*4, 2);
    memcpy(tcp.useless, eth + 18+ip.ihl*4, 8);
    memcpy(tcp.ihl, eth + 26+ip.ihl*5, 1);
    memcpy(tcp.useless_2, eth + 27+ip.ihl*5, 7);

    int header_len = ((eth[ip.ihl*4] >> 4) & 0x0F) * 4 + ip.ihl*4;

    memcpy(other.a,eth+header_len,header->caplen);

    printf("==========Ethernet Header==========\n");
    printf("Dst Mac: %02x:%02x:%02x:%02x:%02x:%02x\n",
            idernet.dst_mac[0],idernet.dst_mac[1],idernet.dst_mac[2],idernet.dst_mac[3],idernet.dst_mac[4],idernet.dst_mac[5]);
    printf("Src Mac : %02x:%02x:%02x:%02x:%02x:%02x\n",
            idernet.src_mac[0],idernet.src_mac[1],idernet.src_mac[2],idernet.src_mac[3],idernet.src_mac[4],idernet.src_mac[5]);

    printf("==========Ip Header==========\n");
    printf("Dst ip : %d.%d.%d.%d\n",ip.src_ip[0],ip.src_ip[1],ip.src_ip[2],ip.src_ip[3]);
    printf("src ip : %d.%d.%d.%d\n",ip.dst_ip[0],ip.dst_ip[1],ip.dst_ip[2],ip.dst_ip[3]);

    int src_tcp = (tcp.src_tcp[0] << 8) | tcp.src_tcp[1];
    int dst_tcp = (tcp.dst_tcp[0] << 8) | tcp.dst_tcp[1];

    printf("==========Tcp Header==========\n");
    printf("Dst Port : %d\n",dst_tcp);
    printf("Src Port : %d\n",src_tcp);

    for(int i = 0;i<20 && header->caplen - ip.ihl*4;i++){
        printf("%02x ",other.a[i]);
    }
    printf("\n");
}

int main(int argc, char* argv[]) {
    
    if (!parse(&param, argc, argv))
        return -1;

    char errbuf[PCAP_ERRBUF_SIZE];

    pcap_t* pcap = pcap_open_live(param.dev_, BUFSIZ, 1, 1000, errbuf);

    if (pcap == NULL) {
        fprintf(stderr, "pcap_open_live(%s) return null - %s\n", param.dev_, errbuf);
        return -1;
    }
    while (true) {
        
        struct pcap_pkthdr* header;
        const u_char* packet;
        

        int res = pcap_next_ex(pcap, &header, &packet);
       

        if (res == 0)
            continue;

        if (res == PCAP_ERROR || res == PCAP_ERROR_BREAK) {
            printf("pcap_next_ex return %d(%s)\n", res, pcap_geterr(pcap));
            break;
        }

        last_printf(header,packet);
        
    }

    pcap_close(pcap);
}
